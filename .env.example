PORT=3000
NODE_ENV=production
GEMINI_API_KEY=your_gemini_api_key_here
WHATSAPP_ADMIN_NUMBERS=5562999999999
WHATSAPP_ALLOWED_NUMBERS=
HORA_RELATORIO_DIARIO=07:30
MINUTO_RELATORIO_DIARIO=30
API_KEY=your_m2m_api_key_here
AUTH_USER=
AUTH_PASSWORD=

# Testes/manutenção: desativa WhatsApp e agendador
DISABLE_INTEGRATIONS=false
# DB_PATH pode apontar para um banco isolado nos testes.

# Fiscal: exclusivamente homologação; nunca colocar credenciais no navegador.
# Configure uma chave aleatória de 32 bytes em hexadecimal no cofre do servidor.
FISCAL_ENCRYPTION_KEY=
# Mapa JSON tenant -> token de HOMOLOGAÇÃO Focus, provisionado pelo operador.
FISCAL_FOCUS_TOKENS={}
# Diretórios absolutos por ambiente. Em testes, o runner usa diretórios temporários.
# BACKUP_DIR=
# UPLOAD_DIR=
# HOST=127.0.0.1
